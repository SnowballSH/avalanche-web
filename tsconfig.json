{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"sourceMap": true,
		"types": ["$app/types"]
	},
	"include": [
		"./csp.config.ts",
		"./vite.config.ts",
		"./playwright.config.ts",
		"./playwright.served.config.ts",
		"./scripts/**/*.ts",
		"./src/**/*.js",
		"./src/**/*.ts",
		"./src/**/*.svelte",
		"./tests/**/*.ts",
		"./vendor/avalanche-web-abi2/src/**/*.ts"
	],
	"exclude": ["./node_modules", "./vendor/avalanche-web-abi2/src/node/**"]
}
